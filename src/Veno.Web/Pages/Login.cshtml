@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
    ViewData["BodyClass"] = "auth-page";
}

<main class="auth-shell">
    <section class="auth-story" aria-label="Sobre a Veno">
        <span class="eyebrow"><i></i> Plataforma de comunicação</span>
        <h1>Mensagens que chegam.<br /><em>Conexões que ficam.</em></h1>
        <p>Uma ponte segura entre seus sistemas e cada conversa importante.</p>
        <div class="connection-visual" aria-hidden="true">
            <span class="connection-node node-a"></span>
            <span class="connection-node node-b"></span>
            <span class="connection-node node-c"></span>
            <span class="connection-line line-a"></span>
            <span class="connection-line line-b"></span>
        </div>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <img class="auth-logo" src="~/images/veno-logo.png" alt="Veno" />
            <div class="auth-heading">
                <p>Bem-vindo de volta</p>
                <h2>Acesse sua plataforma</h2>
            </div>

            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                <label asp-for="Input.Email">E-mail</label>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
                    <input asp-for="Input.Email" autocomplete="username" placeholder="voce@empresa.com" autofocus />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation"></span>

                <div class="label-row">
                    <label asp-for="Input.Password">Senha</label>
                    <span>Esqueceu a senha?</span>
                </div>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2M5 10h14v10H5z" /></svg>
                    <input asp-for="Input.Password" autocomplete="current-password" placeholder="Digite sua senha" />
                </div>
                <span asp-validation-for="Input.Password" class="field-validation"></span>

                <button type="submit" class="primary-button">
                    Entrar
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </button>
            </form>

            @if (Model.ShowDevelopmentCredentials)
            {
                <p class="demo-access">Ambiente local: <strong>admin@veno.local</strong> / <strong>Veno@@123</strong></p>
            }
        </div>

        <footer class="auth-footer">
            <span>© @DateTime.UtcNow.Year Veno</span>
            <span>Envios sem fronteiras</span>
        </footer>
    </section>
</main>
