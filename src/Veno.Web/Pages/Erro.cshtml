@page "/erro"
@model ErroModel
@{
    ViewData["Title"] = "Algo não saiu como esperado";
    ViewData["BodyClass"] = "auth-page";
}
<main class="simple-message">
    <img src="~/images/veno-logo.png" alt="Veno" />
    <h1>Não foi possível concluir esta ação.</h1>
    <p>Tente novamente em alguns instantes.</p>
    <a asp-page="/Index" class="primary-button">Voltar ao início</a>
</main>
