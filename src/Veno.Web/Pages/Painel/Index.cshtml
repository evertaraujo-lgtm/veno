@page "/painel"
@model Veno.Web.Pages.Painel.IndexModel
@{
    ViewData["Title"] = "Painel";
    ViewData["BodyClass"] = "dashboard-page";
}

<div class="dashboard-shell">
    <aside class="sidebar">
        <a asp-page="/Painel/Index" class="sidebar-brand" aria-label="Veno — início">
            <img src="~/images/veno-logo.png" alt="Veno" />
        </a>

        <nav class="sidebar-nav" aria-label="Navegação principal">
            <span class="nav-caption">Workspace</span>
            <a class="nav-item active" asp-page="/Painel/Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4zm10 7h6v-9h-6zM4 20h6v-3H4zm10-13h6V4h-6z" /></svg>
                Visão geral
            </a>
            <a class="nav-item disabled" href="#" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h6" /></svg>
                Templates
                <span>Em breve</span>
            </a>
            <a class="nav-item disabled" href="#" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 18-8-8 18-2-8z" /></svg>
                Disparos
            </a>
            <a class="nav-item disabled" href="#" aria-disabled="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12h8M12 8v8M5 4h14v16H5z" /></svg>
                Integrações
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="workspace-card">
                <span class="status-dot"></span>
                <div><strong>Ambiente</strong><small>Desenvolvimento</small></div>
            </div>
            <form method="post" asp-page="/Logout">
                <button type="submit" class="logout-button">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10" /></svg>
                    Sair
                </button>
            </form>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div>
                <span class="eyebrow"><i></i> Operação online</span>
                <h1>Olá, Everton.</h1>
                <p>Acompanhe a operação da Veno em um só lugar.</p>
            </div>
            <div class="user-chip" title="@User.Identity?.Name">
                <span>EV</span>
                <div><strong>Administrador</strong><small>@User.Identity?.Name</small></div>
            </div>
        </header>

        <section class="metric-grid" aria-label="Indicadores">
            <article class="metric-card accent">
                <div class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 18-8-8 18-2-8z" /></svg></div>
                <span>Mensagens enviadas</span>
                <strong>0</strong>
                <small>Pronto para o primeiro envio</small>
            </article>
            <article class="metric-card">
                <div class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h6" /></svg></div>
                <span>Templates ativos</span>
                <strong>0</strong>
                <small>Aguardando integração Meta</small>
            </article>
            <article class="metric-card">
                <div class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></div>
                <span>Taxa de entrega</span>
                <strong>—</strong>
                <small>Sem dados no período</small>
            </article>
            <article class="metric-card">
                <div class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9M12 7v5l3 2" /></svg></div>
                <span>Em processamento</span>
                <strong>0</strong>
                <small>Nenhum item na fila</small>
            </article>
        </section>

        <section class="dashboard-grid">
            <article class="content-card activity-card">
                <div class="card-heading">
                    <div><span>Atividade</span><h2>Últimos disparos</h2></div>
                    <button type="button" disabled>Ver todos</button>
                </div>
                <div class="empty-state">
                    <span class="empty-orbit"><i></i></span>
                    <h3>Tudo pronto para começar</h3>
                    <p>Os disparos aparecerão aqui assim que a integração estiver configurada.</p>
                </div>
            </article>

            <article class="content-card setup-card">
                <div class="card-heading"><div><span>Configuração</span><h2>Primeiros passos</h2></div></div>
                <ol class="setup-list">
                    <li class="done"><span>1</span><div><strong>Ambiente Veno</strong><small>Base criada e disponível</small></div></li>
                    <li><span>2</span><div><strong>Conectar à Meta</strong><small>Credenciais da Cloud API</small></div></li>
                    <li><span>3</span><div><strong>Sincronizar templates</strong><small>Modelos aprovados</small></div></li>
                    <li><span>4</span><div><strong>Ativar aplicação</strong><small>Chave de acesso à API</small></div></li>
                </ol>
            </article>
        </section>
    </main>
</div>
