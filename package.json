{
  "name": "veno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc6 --noEmit && vite build",
    "build:emulator": "tsc6 --noEmit && vite build --mode development",
    "emulators": "npm run build:emulator && firebase emulators:start",
    "emulators:auth": "firebase emulators:start --only auth,firestore",
    "preview": "vite preview",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run src",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-veno-rules --config firebase.rules-test.json \"vitest run tests/firestore.rules.test.ts\"",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run test:functions && npm run test:rules && vite build"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
